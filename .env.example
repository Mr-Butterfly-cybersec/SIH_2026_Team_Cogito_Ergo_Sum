# Copy to .env and fill in. Never commit .env.

# --- database ---
POSTGRES_USER=crq
POSTGRES_PASSWORD=crq
POSTGRES_DB=crq
# Local default (docker-compose). For Neon use the -pooler host:
#   postgresql+asyncpg://<user>:<pw>@<host>-pooler.<region>.aws.neon.tech/<db>?ssl=require
DATABASE_URL=postgresql+asyncpg://crq:crq@localhost:5432/crq

# --- app ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
ADMIN_SECRET=change-me

# --- threat intel (all optional / free) ---
# Free NVD key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- ai layer (free tiers; first available in the fallback chain is used) ---
# The platform works with none of these: it answers from the deterministic engine and says so.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- local model (Ollama) ---
# Ollama must be RUNNING and the model must be PULLED, and only some models support tool
# calling — the explanation layer needs that. llama3.2 does; llava, deepseek-r1 and plain
# mistral do not (mistral answers with prose *about* calling a tool, which is rejected).
#   ollama pull llama3.2
#
# Two gotchas that make this fail silently otherwise:
#   1. `ollama serve` binds 127.0.0.1 by default, so a *containerised* API cannot reach it.
#      Either run the API on the host (`make dev-api`), or rebind: OLLAMA_HOST=0.0.0.0 ollama serve
#   2. From inside Docker, `localhost` is the container. Use the host gateway:
#      OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.2

# NOTE: the fastest path to a working LLM is a free Groq key (console.groq.com) — one env var,
# no multi-GB download, and far better at tool calling than a small local model.

# --- frontend ---
# Leave empty when the Next server proxies to the API (the default). See frontend/next.config.ts.
NEXT_PUBLIC_API_BASE_URL=
